// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`schema: policies, funções, triggers, RLS e unicidade 1`] = `
{
  "functions": {
    "activate_threshold_profile(p_profile_id uuid)": "CREATE OR REPLACE FUNCTION public.activate_threshold_profile(p_profile_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_org_id uuid;
  v_old_config jsonb;
  v_new_config jsonb;
  v_caller uuid;
BEGIN
  v_caller := auth.uid();

  -- Validate caller is a professional
  IF NOT public.has_role(v_caller, 'professional') THEN
    RAISE EXCEPTION 'Only professionals can activate threshold profiles';
  END IF;

  -- Lock the target profile row and get org_id
  SELECT organization_id, config INTO v_org_id, v_new_config
  FROM public.clinical_threshold_profiles
  WHERE id = p_profile_id
  FOR UPDATE;

  IF v_org_id IS NULL THEN
    RAISE EXCEPTION 'Profile not found: %', p_profile_id;
  END IF;

  -- Validate caller is member of the organization
  IF NOT public.is_org_member(v_org_id, v_caller) THEN
    RAISE EXCEPTION 'Not a member of this organization';
  END IF;

  -- Get current active profile config for audit
  SELECT config INTO v_old_config
  FROM public.clinical_threshold_profiles
  WHERE organization_id = v_org_id AND is_active = true;

  -- Deactivate all profiles in this org
  UPDATE public.clinical_threshold_profiles
  SET is_active = false, updated_at = now()
  WHERE organization_id = v_org_id AND is_active = true;

  -- Activate the requested profile
  UPDATE public.clinical_threshold_profiles
  SET is_active = true, updated_at = now()
  WHERE id = p_profile_id;

  -- Audit log
  INSERT INTO public.clinical_threshold_audit_log (profile_id, action, changed_by, before_config, after_config, reason)
  VALUES (p_profile_id, 'activate', v_caller, v_old_config, v_new_config, 'Profile activated via RPC');
END;
$function$
",
    "active_red_flags(_flags jsonb, _has boolean)": "CREATE OR REPLACE FUNCTION public.active_red_flags(_flags jsonb, _has boolean)
 RETURNS text[]
 LANGUAGE sql
 IMMUTABLE
 SET search_path TO ''
AS $function$
  SELECT CASE
    WHEN cardinality(f.keys) > 0 THEN f.keys
    WHEN _has IS TRUE THEN ARRAY['unspecified']
    ELSE ARRAY[]::text[]
  END
  FROM (
    SELECT ARRAY(
      SELECT e.key
      FROM jsonb_each(CASE WHEN jsonb_typeof(_flags) = 'object' THEN _flags ELSE '{}'::jsonb END) AS e
      WHERE e.value = 'true'::jsonb
      ORDER BY e.key COLLATE "C"
    ) AS keys
  ) AS f
$function$
",
    "assessment_red_flag_status(_assessment_id uuid)": "CREATE OR REPLACE FUNCTION public.assessment_red_flag_status(_assessment_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  _uid uuid := auth.uid();
  _owner uuid;
  _active text[];
  _version bigint;
  _clearance record;
BEGIN
  SELECT a.professional_id INTO _owner FROM public.assessments a WHERE a.id = _assessment_id;
  IF _uid IS NULL OR _owner IS DISTINCT FROM _uid OR NOT public.has_role(_uid, 'professional'::public.app_role) THEN
    RAISE EXCEPTION 'assessment not found or not yours' USING ERRCODE = '42501';
  END IF;

  SELECT public.active_red_flags(r.red_flags, r.has_red_flags), r.red_flags_version INTO _active, _version
  FROM public.anamnesis_responses r
  WHERE r.assessment_id = _assessment_id;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('blocked', 'anamnesis_missing', 'active_flags', '[]'::jsonb, 'clearance', NULL);
  END IF;
  IF cardinality(_active) = 0 THEN
    RETURN jsonb_build_object('blocked', NULL, 'active_flags', '[]'::jsonb, 'clearance', NULL);
  END IF;

  SELECT c.id, c.justification, c.created_at INTO _clearance
  FROM public.red_flag_clearances c
  WHERE c.id = public.valid_red_flag_clearance(_assessment_id, NULL, _active, _version);
  RETURN jsonb_build_object(
    'blocked', CASE WHEN _clearance.id IS NULL THEN 'red_flags_not_cleared' END,
    'active_flags', to_jsonb(_active),
    'clearance', CASE WHEN _clearance.id IS NOT NULL THEN
      jsonb_build_object('id', _clearance.id, 'justification', _clearance.justification, 'created_at', _clearance.created_at) END);
END;
$function$
",
    "assign_server_row_id()": "CREATE OR REPLACE FUNCTION public.assign_server_row_id()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
BEGIN
  IF TG_OP = 'INSERT' AND current_user IN ('authenticated', 'anon') THEN
    NEW.id := gen_random_uuid();
  ELSIF TG_OP = 'UPDATE' AND NEW.id IS NOT DISTINCT FROM OLD.id THEN
    RETURN NEW;
  END IF;

  PERFORM pg_advisory_xact_lock(hashtextextended(NEW.id::text, 0));

  IF (TG_TABLE_NAME = 'assessments'
      AND EXISTS (SELECT 1 FROM public.quick_protocol_sessions q WHERE q.id = NEW.id))
     OR (TG_TABLE_NAME = 'quick_protocol_sessions'
      AND EXISTS (SELECT 1 FROM public.assessments a WHERE a.id = NEW.id)) THEN
    RAISE EXCEPTION 'id already used by an assessment or quick protocol session'
      USING ERRCODE = '23505';
  END IF;

  RETURN NEW;
END;
$function$
",
    "can_author_assessment(_assessment_id uuid)": "CREATE OR REPLACE FUNCTION public.can_author_assessment(_assessment_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE
 SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM public.assessments a
    WHERE a.id = _assessment_id
      AND a.professional_id = auth.uid()
      AND a.status IN ('draft', 'in_progress')
  )
  AND public.has_role(auth.uid(), 'professional'::app_role)
$function$
",
    "clear_assessment_red_flags(_assessment_id uuid, _justification text)": "CREATE OR REPLACE FUNCTION public.clear_assessment_red_flags(_assessment_id uuid, _justification text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  _uid uuid := auth.uid();
  _text text := btrim(_justification, E' \\t\\r\\n');
  _assessment record;
  _active text[];
  _version bigint;
  _id uuid;
BEGIN
  IF _text IS NULL OR char_length(_text) NOT BETWEEN 20 AND 2000 THEN
    RAISE EXCEPTION 'the justification needs 20 to 2000 characters' USING ERRCODE = '22023';
  END IF;
  IF _uid IS NULL OR NOT public.has_role(_uid, 'professional'::public.app_role) THEN
    RAISE EXCEPTION 'assessment not found or not yours' USING ERRCODE = '42501';
  END IF;

  -- The assessment first, then its anamnesis, as save_assessment_protocol
  SELECT a.professional_id, a.status INTO _assessment
  FROM public.assessments a
  WHERE a.id = _assessment_id
  FOR UPDATE;
  IF NOT FOUND OR _assessment.professional_id IS DISTINCT FROM _uid OR _assessment.status NOT IN ('draft', 'in_progress') THEN
    RAISE EXCEPTION 'assessment not found or not yours' USING ERRCODE = '42501';
  END IF;

  SELECT public.active_red_flags(r.red_flags, r.has_red_flags), r.red_flags_version INTO _active, _version
  FROM public.anamnesis_responses r
  WHERE r.assessment_id = _assessment_id
  FOR UPDATE;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'anamnesis_missing' USING ERRCODE = 'P0001';
  END IF;
  IF cardinality(_active) = 0 THEN
    RAISE EXCEPTION 'no active red flag to clear' USING ERRCODE = '22023';
  END IF;

  INSERT INTO public.red_flag_clearances (assessment_id, professional_id, justification, cleared_flags, red_flags_version)
  VALUES (_assessment_id, _uid, _text, _active, _version)
  RETURNING id INTO _id;
  RETURN _id;
END;
$function$
",
    "clear_quick_session_red_flags(_session_id uuid, _justification text)": "CREATE OR REPLACE FUNCTION public.clear_quick_session_red_flags(_session_id uuid, _justification text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  _uid uuid := auth.uid();
  _text text := btrim(_justification, E' \\t\\r\\n');
  _session record;
  _active text[];
  _id uuid;
BEGIN
  IF _text IS NULL OR char_length(_text) NOT BETWEEN 20 AND 2000 THEN
    RAISE EXCEPTION 'the justification needs 20 to 2000 characters' USING ERRCODE = '22023';
  END IF;
  IF _uid IS NULL OR NOT public.has_role(_uid, 'professional'::public.app_role) THEN
    RAISE EXCEPTION 'quick protocol session not found or not yours' USING ERRCODE = '42501';
  END IF;

  -- The session row is the lock for its completion, its red flags, clearing and revoking
  SELECT q.professional_id, q.status, q.red_flags, q.red_flags_version INTO _session
  FROM public.quick_protocol_sessions q
  WHERE q.id = _session_id
  FOR UPDATE;
  IF NOT FOUND OR _session.professional_id IS DISTINCT FROM _uid OR _session.status IS DISTINCT FROM 'in_progress' THEN
    RAISE EXCEPTION 'quick protocol session not found or not yours' USING ERRCODE = '42501';
  END IF;
  IF jsonb_typeof(_session.red_flags) IS DISTINCT FROM 'object' THEN
    RAISE EXCEPTION 'triage_missing' USING ERRCODE = 'P0001';
  END IF;
  _active := public.active_red_flags(_session.red_flags, NULL);
  IF cardinality(_active) = 0 THEN
    RAISE EXCEPTION 'no active red flag to clear' USING ERRCODE = '22023';
  END IF;

  INSERT INTO public.red_flag_clearances (quick_session_id, professional_id, justification, cleared_flags, red_flags_version)
  VALUES (_session_id, _uid, _text, _active, _session.red_flags_version)
  RETURNING id INTO _id;
  RETURN _id;
END;
$function$
",
    "guard_anamnesis_red_flags()": "CREATE OR REPLACE FUNCTION public.guard_anamnesis_red_flags()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  _status text;
BEGIN
  IF TG_OP IN ('UPDATE', 'DELETE') THEN
    SELECT a.status INTO _status FROM public.assessments a WHERE a.id = OLD.assessment_id;
    -- The assessment is gone: this is its cascade
    IF NOT FOUND AND TG_OP = 'DELETE' THEN
      RETURN OLD;
    END IF;
    IF _status IS NULL OR _status NOT IN ('draft', 'in_progress') THEN
      RAISE EXCEPTION 'the anamnesis changes only while its assessment is open' USING ERRCODE = '42501';
    END IF;
    IF TG_OP = 'DELETE' THEN
      RETURN OLD;
    END IF;
  END IF;

  IF TG_OP = 'INSERT' OR NEW.assessment_id IS DISTINCT FROM OLD.assessment_id THEN
    SELECT a.status INTO _status FROM public.assessments a WHERE a.id = NEW.assessment_id;
    IF _status IS NULL OR _status NOT IN ('draft', 'in_progress') THEN
      RAISE EXCEPTION 'the anamnesis changes only while its assessment is open' USING ERRCODE = '42501';
    END IF;
    -- New here: no clearance of this assessment was given for these red flags
    NEW.red_flags_version := public.red_flags_next_version(NULL, public.active_red_flags(NEW.red_flags, NEW.has_red_flags), 0);
  ELSE
    NEW.red_flags_version := public.red_flags_next_version(
      public.active_red_flags(OLD.red_flags, OLD.has_red_flags),
      public.active_red_flags(NEW.red_flags, NEW.has_red_flags),
      OLD.red_flags_version);
  END IF;
  RETURN NEW;
END;
$function$
",
    "guard_assessment_update()": "CREATE OR REPLACE FUNCTION public.guard_assessment_update()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
BEGIN
  IF current_user NOT IN ('authenticated', 'anon') THEN
    RETURN NEW;
  END IF;

  IF TG_OP = 'INSERT' THEN
    NEW.created_at := now();
    NEW.completed_at := NULL;
    RETURN NEW;
  END IF;

  IF OLD.status IN ('draft', 'in_progress') THEN
    IF NEW.created_at IS DISTINCT FROM OLD.created_at THEN
      RAISE EXCEPTION 'assessment creation date cannot be changed'
        USING ERRCODE = '42501';
    END IF;
    IF NEW.status NOT IN ('draft', 'in_progress', 'completed') THEN
      RAISE EXCEPTION 'an open assessment can only be completed'
        USING ERRCODE = '42501';
    END IF;
    IF NEW.status = 'completed' THEN
      IF NOT EXISTS (SELECT 1 FROM public.protocols p WHERE p.assessment_id = NEW.id) THEN
        RAISE EXCEPTION 'an assessment is completed only after its protocol is saved'
          USING ERRCODE = '42501';
      END IF;
      NEW.completed_at := now();
    ELSE
      NEW.completed_at := OLD.completed_at;
    END IF;
  END IF;

  IF NEW.id IS DISTINCT FROM OLD.id
     OR NEW.professional_id IS DISTINCT FROM OLD.professional_id
     OR NEW.student_id IS DISTINCT FROM OLD.student_id THEN
    RAISE EXCEPTION 'assessment id, professional and student cannot be changed'
      USING ERRCODE = '42501';
  END IF;

  IF OLD.status IN ('completed', 'archived') THEN
    IF (to_jsonb(NEW) - 'updated_at' - 'status') IS DISTINCT FROM (to_jsonb(OLD) - 'updated_at' - 'status')
       OR NOT (NEW.status = OLD.status OR (OLD.status = 'completed' AND NEW.status = 'archived')) THEN
      RAISE EXCEPTION 'completed assessments are immutable'
        USING ERRCODE = '42501';
    END IF;
  END IF;

  RETURN NEW;
END;
$function$
",
    "guard_protocol_write()": "CREATE OR REPLACE FUNCTION public.guard_protocol_write()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO ''
AS $function$
DECLARE
  _active text[];
  _version bigint;
BEGIN
  IF current_user IS DISTINCT FROM (SELECT pg_catalog.pg_get_userbyid(c.relowner) FROM pg_catalog.pg_class c WHERE c.oid = TG_RELID) THEN
    RAISE EXCEPTION 'protocols are written only by save_assessment_protocol' USING ERRCODE = '42501';
  END IF;

  IF TG_OP = 'TRUNCATE' THEN
    RETURN NULL;
  ELSIF TG_OP = 'DELETE' THEN
    RETURN OLD;
  END IF;

  SELECT public.active_red_flags(r.red_flags, r.has_red_flags), r.red_flags_version INTO _active, _version
  FROM public.anamnesis_responses r
  WHERE r.assessment_id = NEW.assessment_id;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'anamnesis_missing' USING ERRCODE = 'P0001';
  END IF;
  IF NOT public.red_flags_cleared(NEW.assessment_id, NULL, _active, _version) THEN
    RAISE EXCEPTION 'red_flags_not_cleared' USING ERRCODE = 'P0001';
  END IF;
  RETURN NEW;
END;
$function$
",
    "guard_quick_session_red_flags()": "CREATE OR REPLACE FUNCTION public.guard_quick_session_red_flags()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  _active text[];
BEGIN
  _active := public.active_red_flags(NEW.red_flags, NULL);
  IF TG_OP = 'INSERT' THEN
    NEW.red_flags_version := public.red_flags_next_version(NULL, _active, 0);
    -- No triage, no session
    IF jsonb_typeof(NEW.red_flags) IS DISTINCT FROM 'object' THEN
      RAISE EXCEPTION 'triage_missing' USING ERRCODE = 'P0001';
    END IF;
    -- The intervention only comes in through an UPDATE, which goes through the lock below
    IF NEW.intervention_applied IS NOT NULL OR NEW.status IS DISTINCT FROM 'in_progress' THEN
      RAISE EXCEPTION 'a quick protocol session starts in progress and without an intervention' USING ERRCODE = '42501';
    END IF;
    RETURN NEW;
  END IF;

  NEW.red_flags_version := public.red_flags_next_version(
    public.active_red_flags(OLD.red_flags, NULL), _active, OLD.red_flags_version);
  IF NEW.status = 'completed' OR NEW.intervention_applied IS NOT NULL THEN
    IF jsonb_typeof(NEW.red_flags) IS DISTINCT FROM 'object' THEN
      RAISE EXCEPTION 'triage_missing' USING ERRCODE = 'P0001';
    END IF;
    IF NOT public.red_flags_cleared(NULL, NEW.id, _active, NEW.red_flags_version) THEN
      RAISE EXCEPTION 'red_flags_not_cleared' USING ERRCODE = 'P0001';
    END IF;
  END IF;
  RETURN NEW;
END;
$function$
",
    "guard_quick_session_update()": "CREATE OR REPLACE FUNCTION public.guard_quick_session_update()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
BEGIN
  IF current_user NOT IN ('authenticated', 'anon') THEN
    RETURN NEW;
  END IF;

  IF NEW.id IS DISTINCT FROM OLD.id
     OR NEW.professional_id IS DISTINCT FROM OLD.professional_id
     OR NEW.student_id IS DISTINCT FROM OLD.student_id
     OR NEW.assessment_id IS DISTINCT FROM OLD.assessment_id THEN
    RAISE EXCEPTION 'quick protocol session id, professional, student and assessment cannot be changed'
      USING ERRCODE = '42501';
  END IF;

  RETURN NEW;
END;
$function$
",
    "handle_new_user()": "CREATE OR REPLACE FUNCTION public.handle_new_user()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  INSERT INTO public.profiles (id, full_name, email)
  VALUES (
    NEW.id,
    COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.email),
    NEW.email
  );

  -- Default role is 'student', professionals are assigned manually
  INSERT INTO public.user_roles (user_id, role)
  VALUES (NEW.id, 'student');

  RETURN NEW;
END;
$function$
",
    "has_role(_user_id uuid, _role app_role)": "CREATE OR REPLACE FUNCTION public.has_role(_user_id uuid, _role app_role)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM public.user_roles
    WHERE user_id = _user_id AND role = _role
  )
$function$
",
    "is_org_member(_org_id uuid, _user_id uuid)": "CREATE OR REPLACE FUNCTION public.is_org_member(_org_id uuid, _user_id uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM public.organization_members
    WHERE organization_id = _org_id AND user_id = _user_id
  )
$function$
",
    "quick_session_red_flag_status(_session_id uuid)": "CREATE OR REPLACE FUNCTION public.quick_session_red_flag_status(_session_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  _uid uuid := auth.uid();
  _session record;
  _active text[];
  _clearance record;
BEGIN
  SELECT q.professional_id, q.red_flags, q.red_flags_version INTO _session
  FROM public.quick_protocol_sessions q
  WHERE q.id = _session_id;
  IF NOT FOUND OR _uid IS NULL OR _session.professional_id IS DISTINCT FROM _uid
     OR NOT public.has_role(_uid, 'professional'::public.app_role) THEN
    RAISE EXCEPTION 'quick protocol session not found or not yours' USING ERRCODE = '42501';
  END IF;

  IF jsonb_typeof(_session.red_flags) IS DISTINCT FROM 'object' THEN
    RETURN jsonb_build_object('blocked', 'triage_missing', 'active_flags', '[]'::jsonb, 'clearance', NULL);
  END IF;
  _active := public.active_red_flags(_session.red_flags, NULL);
  IF cardinality(_active) = 0 THEN
    RETURN jsonb_build_object('blocked', NULL, 'active_flags', '[]'::jsonb, 'clearance', NULL);
  END IF;

  SELECT c.id, c.justification, c.created_at INTO _clearance
  FROM public.red_flag_clearances c
  WHERE c.id = public.valid_red_flag_clearance(NULL, _session_id, _active, _session.red_flags_version);
  RETURN jsonb_build_object(
    'blocked', CASE WHEN _clearance.id IS NULL THEN 'red_flags_not_cleared' END,
    'active_flags', to_jsonb(_active),
    'clearance', CASE WHEN _clearance.id IS NOT NULL THEN
      jsonb_build_object('id', _clearance.id, 'justification', _clearance.justification, 'created_at', _clearance.created_at) END);
END;
$function$
",
    "quick_session_red_flags_version()": "CREATE OR REPLACE FUNCTION public.quick_session_red_flags_version()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
BEGIN
  IF TG_OP = 'INSERT' THEN
    NEW.red_flags_version := public.red_flags_next_version(NULL, public.active_red_flags(NEW.red_flags, NULL), 0);
  ELSE
    NEW.red_flags_version := public.red_flags_next_version(
      public.active_red_flags(OLD.red_flags, NULL), public.active_red_flags(NEW.red_flags, NULL), OLD.red_flags_version);
  END IF;
  RETURN NEW;
END;
$function$
",
    "red_flags_cleared(_assessment_id uuid, _quick_session_id uuid, _active text[], _version bigint)": "CREATE OR REPLACE FUNCTION public.red_flags_cleared(_assessment_id uuid, _quick_session_id uuid, _active text[], _version bigint)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  SELECT _active IS NOT NULL
    AND (cardinality(_active) = 0
      OR public.valid_red_flag_clearance(_assessment_id, _quick_session_id, _active, _version) IS NOT NULL)
$function$
",
    "red_flags_next_version(_old text[], _new text[], _version bigint)": "CREATE OR REPLACE FUNCTION public.red_flags_next_version(_old text[], _new text[], _version bigint)
 RETURNS bigint
 LANGUAGE sql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
  SELECT CASE
    WHEN _old IS NULL THEN CASE WHEN cardinality(_new) > 0 THEN nextval('public.red_flags_version_seq') ELSE 0 END
    WHEN _old @> _new THEN _version
    ELSE nextval('public.red_flags_version_seq')
  END
$function$
",
    "revoke_red_flag_clearance(_clearance_id uuid, _reason text)": "CREATE OR REPLACE FUNCTION public.revoke_red_flag_clearance(_clearance_id uuid, _reason text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  _uid uuid := auth.uid();
  _text text := btrim(_reason, E' \\t\\r\\n');
  _clearance record;
  _owner uuid;
  _open boolean;
BEGIN
  IF _text IS NULL OR char_length(_text) NOT BETWEEN 20 AND 2000 THEN
    RAISE EXCEPTION 'the reason needs 20 to 2000 characters' USING ERRCODE = '22023';
  END IF;
  IF _uid IS NULL OR NOT public.has_role(_uid, 'professional'::public.app_role) THEN
    RAISE EXCEPTION 'clearance not found or not yours' USING ERRCODE = '42501';
  END IF;

  SELECT c.assessment_id, c.quick_session_id INTO _clearance
  FROM public.red_flag_clearances c
  WHERE c.id = _clearance_id;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'clearance not found or not yours' USING ERRCODE = '42501';
  END IF;

  IF _clearance.assessment_id IS NOT NULL THEN
    SELECT a.professional_id, a.status IN ('draft', 'in_progress') INTO _owner, _open
    FROM public.assessments a
    WHERE a.id = _clearance.assessment_id
    FOR UPDATE;
  ELSE
    SELECT q.professional_id, q.status = 'in_progress' INTO _owner, _open
    FROM public.quick_protocol_sessions q
    WHERE q.id = _clearance.quick_session_id
    FOR UPDATE;
  END IF;
  IF _owner IS DISTINCT FROM _uid OR _open IS NOT TRUE THEN
    RAISE EXCEPTION 'clearance not found or not yours' USING ERRCODE = '42501';
  END IF;

  IF EXISTS (SELECT 1 FROM public.red_flag_clearance_revocations r WHERE r.clearance_id = _clearance_id) THEN
    RAISE EXCEPTION 'clearance already revoked' USING ERRCODE = '23505';
  END IF;
  INSERT INTO public.red_flag_clearance_revocations (clearance_id, professional_id, reason)
  VALUES (_clearance_id, _uid, _text);
END;
$function$
",
    "save_assessment_protocol(_assessment_id uuid, _protocol jsonb, _findings jsonb)": "CREATE OR REPLACE FUNCTION public.save_assessment_protocol(_assessment_id uuid, _protocol jsonb, _findings jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO ''
AS $function$
DECLARE
  _uid uuid := auth.uid();
  _assessment record;
  _protocol_id uuid;
  _active text[];
  _version bigint;
BEGIN
  -- A forgotten argument must not become "no findings"
  IF jsonb_typeof(_protocol) IS DISTINCT FROM 'object' OR jsonb_typeof(_findings) IS DISTINCT FROM 'array' THEN
    RAISE EXCEPTION 'protocol must be an object and findings a list' USING ERRCODE = '22023';
  END IF;

  IF _uid IS NULL OR NOT public.has_role(_uid, 'professional'::public.app_role) THEN
    RAISE EXCEPTION 'only a professional can save a protocol' USING ERRCODE = '42501';
  END IF;

  -- Serializes concurrent saves of the same assessment
  SELECT a.professional_id, a.status INTO _assessment
  FROM public.assessments a
  WHERE a.id = _assessment_id
  FOR UPDATE;

  -- Someone else's assessment gets the same answer as a missing one
  IF NOT FOUND OR _assessment.professional_id IS DISTINCT FROM _uid THEN
    RAISE EXCEPTION 'assessment not found or not yours' USING ERRCODE = '42501';
  END IF;

  -- A repeated save (second click, or a retry after a lost response) gets the saved protocol back
  IF _assessment.status = 'completed' THEN
    SELECT p.id INTO _protocol_id
    FROM public.protocols p
    WHERE p.assessment_id = _assessment_id;
    IF _protocol_id IS NULL THEN
      RAISE EXCEPTION 'completed assessment without a protocol' USING ERRCODE = '42501';
    END IF;
    RETURN _protocol_id;
  END IF;

  IF _assessment.status NOT IN ('draft', 'in_progress') THEN
    RAISE EXCEPTION 'only an open assessment can be completed' USING ERRCODE = '42501';
  END IF;

  -- Etapa 5a: the anamnesis row is the queue shared with its writers. A red flag marked before this lock is
  -- seen here (the lock returns the committed row); one marked after waits and then finds the assessment
  -- completed (guard_anamnesis_red_flags). Without an anamnesis there was no triage.
  SELECT public.active_red_flags(r.red_flags, r.has_red_flags), r.red_flags_version INTO _active, _version
  FROM public.anamnesis_responses r
  WHERE r.assessment_id = _assessment_id
  FOR UPDATE;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'anamnesis_missing' USING ERRCODE = 'P0001';
  END IF;
  IF NOT public.red_flags_cleared(_assessment_id, NULL, _active, _version) THEN
    RAISE EXCEPTION 'red_flags_not_cleared' USING ERRCODE = 'P0001';
  END IF;

  INSERT INTO public.protocols (
    assessment_id, name, priority_level, frequency_per_week, duration_weeks, phase, exercises
  )
  VALUES (
    _assessment_id,
    _protocol->>'name',
    (_protocol->>'priority_level')::public.priority_level,
    (_protocol->>'frequency_per_week')::integer,
    (_protocol->>'duration_weeks')::integer,
    1,
    COALESCE(_protocol->'exercises', '[]'::jsonb)
  )
  RETURNING id INTO _protocol_id;

  INSERT INTO public.functional_findings (
    assessment_id, classification_tag, body_region, severity, hyperactive_muscles, hypoactive_muscles,
    priority_score, context_weight, biomechanical_importance
  )
  SELECT
    _assessment_id, f.classification_tag, f.body_region, f.severity, COALESCE(f.hyperactive_muscles, '[]'::jsonb),
    COALESCE(f.hypoactive_muscles, '[]'::jsonb), f.priority_score, f.context_weight, f.biomechanical_importance
  FROM jsonb_to_recordset(_findings) AS f(
    classification_tag text,
    body_region text,
    severity public.severity_level,
    hyperactive_muscles jsonb,
    hypoactive_muscles jsonb,
    priority_score numeric,
    context_weight integer,
    biomechanical_importance integer
  );

  -- The cached generation (ProtocolGenerator) is no longer needed once the protocol is saved
  DELETE FROM public.assessment_drafts
  WHERE assessment_id = _assessment_id AND step_type = 'protocol';

  -- What guard_assessment_update does for clients: the server sets the completion date
  UPDATE public.assessments
  SET status = 'completed', completed_at = now()
  WHERE id = _assessment_id;

  RETURN _protocol_id;
END;
$function$
",
    "update_updated_at_column()": "CREATE OR REPLACE FUNCTION public.update_updated_at_column()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$function$
",
    "valid_red_flag_clearance(_assessment_id uuid, _quick_session_id uuid, _active text[], _version bigint)": "CREATE OR REPLACE FUNCTION public.valid_red_flag_clearance(_assessment_id uuid, _quick_session_id uuid, _active text[], _version bigint)
 RETURNS uuid
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO ''
AS $function$
  SELECT c.id
  FROM public.red_flag_clearances c
  WHERE ((_assessment_id IS NOT NULL AND c.assessment_id = _assessment_id)
      OR (_quick_session_id IS NOT NULL AND c.quick_session_id = _quick_session_id))
    AND c.red_flags_version = _version
    AND c.cleared_flags @> _active
    AND NOT EXISTS (SELECT 1 FROM public.red_flag_clearance_revocations r WHERE r.clearance_id = c.id)
  ORDER BY c.created_at DESC, c.id
  LIMIT 1
$function$
",
