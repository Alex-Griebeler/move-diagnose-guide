    "public.quick_protocol_sessions "Professionals can create quick protocol sessions" INSERT {authenticated} PERMISSIVE USING  CHECK ((professional_id = auth.uid()) AND has_role(auth.uid(), 'professional'::app_role) AND (status = 'in_progress'::text) AND (EXISTS ( SELECT 1 FROM professional_students ps WHERE ((ps.professional_id = auth.uid()) AND (ps.student_id = quick_protocol_sessions.student_id)))) AND ((assessment_id IS NULL) OR (EXISTS ( SELECT 1 FROM assessments a WHERE ((a.id = quick_protocol_sessions.assessment_id) AND (a.professional_id = auth.uid()) AND (a.student_id = quick_protocol_sessions.student_id) AND (a.status = ANY (ARRAY['completed'::assessment_status, 'archived'::assessment_status])))))))",
    "public.quick_protocol_sessions "Professionals can delete their quick protocol sessions" DELETE {authenticated} PERMISSIVE USING ((professional_id = auth.uid()) AND has_role(auth.uid(), 'professional'::app_role) AND (status = 'in_progress'::text)) CHECK ",
