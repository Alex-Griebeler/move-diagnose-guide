    "storage.objects "Author can update media while open" UPDATE {authenticated} PERMISSIVE USING ((bucket_id = 'assessment-media'::text) AND ((EXISTS ( SELECT 1 FROM assessments a WHERE (((a.id)::text = (storage.foldername(objects.name))[1]) AND can_author_assessment(a.id)))) OR (EXISTS ( SELECT 1 FROM quick_protocol_sessions qps WHERE (((qps.id)::text = (storage.foldername(objects.name))[1]) AND (qps.professional_id = auth.uid()) AND (qps.status = 'in_progress'::text) AND has_role(auth.uid(), 'professional'::app_role)))))) CHECK ((bucket_id = 'assessment-media'::text) AND ((EXISTS ( SELECT 1 FROM assessments a WHERE (((a.id)::text = (storage.foldername(objects.name))[1]) AND can_author_assessment(a.id)))) OR (EXISTS ( SELECT 1 FROM quick_protocol_sessions qps WHERE (((qps.id)::text = (storage.foldername(objects.name))[1]) AND (qps.professional_id = auth.uid()) AND (qps.status = 'in_progress'::text) AND has_role(auth.uid(), 'professional'::app_role))))))",
