    "public.segmental_test_results "Author can update segmental results while open" UPDATE {authenticated} PERMISSIVE USING can_author_assessment(assessment_id) CHECK can_author_assessment(assessment_id)",
    "public.user_roles "Only system can delete user roles" DELETE {anon,authenticated} PERMISSIVE USING false CHECK ",
