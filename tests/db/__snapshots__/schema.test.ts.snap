    "public.user_roles "Only system can update user roles" UPDATE {anon,authenticated} PERMISSIVE USING false CHECK false",
    "public.user_roles "Users can view own roles" SELECT {public} PERMISSIVE USING (auth.uid() = user_id) CHECK ",
    "storage.objects "Author can delete media while open" DELETE {authenticated} PERMISSIVE USING ((bucket_id = 'assessment-media'::text) AND ((EXISTS ( SELECT 1 FROM assessments a WHERE (((a.id)::text = (storage.foldername(objects.name))[1]) AND can_author_assessment(a.id)))) OR (EXISTS ( SELECT 1 FROM quick_protocol_sessions qps WHERE (((qps.id)::text = (storage.foldername(objects.name))[1]) AND (qps.professional_id = auth.uid()) AND (qps.status = 'in_progress'::text) AND has_role(auth.uid(), 'professional'::app_role)))))) CHECK ",
    "storage.objects "Author can update media while open" UPDATE {authenticated} PERMISSIVE USING ((bucket_id = 'assessment-media'::text) AND ((EXISTS ( SELECT 1 FROM assessments a WHERE (((a.id)::text = (storage.foldername(objects.name))[1]) AND can_author_assessment(a.id)))) OR (EXISTS ( SELECT 1 FROM quick_protocol_sessions qps WHERE (((qps.id)::text = (storage.foldername(objects.name))[1]) AND (qps.professional_id = auth.uid()) AND (qps.status = 'in_progress'::text) AND has_role(auth.uid(), 'professional'::app_role)))))) CHECK ((bucket_id = 'assessment-media'::text) AND ((EXISTS ( SELECT 1 FROM assessments a WHERE (((a.id)::text = (storage.foldername(objects.name))[1]) AND can_author_assessment(a.id)))) OR (EXISTS ( SELECT 1 FROM quick_protocol_sessions qps WHERE (((qps.id)::text = (storage.foldername(objects.name))[1]) AND (qps.professional_id = auth.uid()) AND (qps.status = 'in_progress'::text) AND has_role(auth.uid(), 'professional'::app_role))))))",
    "storage.objects "Author can upload media while open" INSERT {authenticated} PERMISSIVE USING  CHECK ((bucket_id = 'assessment-media'::text) AND ((EXISTS ( SELECT 1 FROM assessments a WHERE (((a.id)::text = (storage.foldername(objects.name))[1]) AND can_author_assessment(a.id)))) OR (EXISTS ( SELECT 1 FROM quick_protocol_sessions qps WHERE (((qps.id)::text = (storage.foldername(objects.name))[1]) AND (qps.professional_id = auth.uid()) AND (qps.status = 'in_progress'::text) AND has_role(auth.uid(), 'professional'::app_role))))))",
    "storage.objects "Professionals can view assessment media" SELECT {public} PERMISSIVE USING ((bucket_id = 'assessment-media'::text) AND (auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1 FROM assessments a WHERE ((a.professional_id = auth.uid()) AND ((a.id)::text = (storage.foldername(objects.name))[1]))))) CHECK ",
    "storage.objects "Students can view own assessment media" SELECT {authenticated} PERMISSIVE USING ((bucket_id = 'assessment-media'::text) AND (EXISTS ( SELECT 1 FROM assessments a WHERE ((a.student_id = auth.uid()) AND ((a.id)::text = (storage.foldername(objects.name))[1]))))) CHECK ",
    "storage.objects "Users can view assessment media" SELECT {public} PERMISSIVE USING ((bucket_id = 'assessment-media'::text) AND ((EXISTS ( SELECT 1 FROM assessments a WHERE (((a.id)::text = (storage.foldername(objects.name))[1]) AND ((a.professional_id = auth.uid()) OR (a.student_id = auth.uid()))))) OR (EXISTS ( SELECT 1 FROM quick_protocol_sessions qps WHERE (((qps.id)::text = (storage.foldername(objects.name))[1]) AND ((qps.professional_id = auth.uid()) OR (qps.student_id = auth.uid()))))))) CHECK ",
  ],
